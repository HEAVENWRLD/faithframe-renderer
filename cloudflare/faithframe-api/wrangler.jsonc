{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "gospel-inspiration-media-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "gospel-inspiration-media"
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "HEAVENWRLD/faithframe-renderer",
    "GITHUB_SHORT_WORKFLOW": "ffmpeg-short-production-render.yml",
    "GITHUB_LONG_WORKFLOW": "ffmpeg-long-production-render.yml",
    "GITHUB_YOUTUBE_WORKFLOW": "ffmpeg-youtube-publish.yml",
    "GITHUB_REF": "main"
  },
  "observability": {
    "enabled": true
  }
}
